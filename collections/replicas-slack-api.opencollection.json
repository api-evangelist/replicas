{
  "opencollection": "1.0.0",
  "info": {
    "name": "Replica Analytics Slack API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Slack",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Attach Slack Thread",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tryreplicas.com/v1/slack/threads/attach",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Routes a Slack thread to a workspace. Agent-mode requests can target only their authenticated workspace; use user or API-key authentication to switch a thread to another workspace."
        }
      ]
    }
  ],
  "bundled": true
}