{
  "opencollection": "1.0.0",
  "info": {
    "name": "Replica Analytics API Keys API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "API Keys",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Personal API Keys",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tryreplicas.com/v1/user/api-keys",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a paginated list of personal API keys for the authenticated user."
        },
        {
          "info": {
            "name": "Create Personal API Key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tryreplicas.com/v1/user/api-keys",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a personal API key scoped to the authenticated user. Requires JWT authentication."
        },
        {
          "info": {
            "name": "Delete Personal API Key",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.tryreplicas.com/v1/user/api-keys/:apiKeyId",
            "params": [
              {
                "name": "apiKeyId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Deletes a personal API key owned by the authenticated user."
        }
      ]
    }
  ],
  "bundled": true
}