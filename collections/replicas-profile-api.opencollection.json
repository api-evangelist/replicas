{
  "opencollection": "1.0.0",
  "info": {
    "name": "Replica Analytics Profile API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Profile",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get User Profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tryreplicas.com/v1/user/profile"
          },
          "docs": "Returns the authenticated user's display name, email, and profile photo."
        },
        {
          "info": {
            "name": "Update User Profile",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.tryreplicas.com/v1/user/profile",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the authenticated user's display name and profile photo. Profile photos are uploaded to the configured S3 object store."
        }
      ]
    }
  ],
  "bundled": true
}