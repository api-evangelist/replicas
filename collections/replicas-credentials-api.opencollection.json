{
  "opencollection": "1.0.0",
  "info": {
    "name": "Replica Analytics Credentials API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Credentials",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get organization OpenCode Go credential status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tryreplicas.com/v1/opencode-go/credentials"
          },
          "docs": "Get organization OpenCode Go credential status"
        },
        {
          "info": {
            "name": "Set the organization OpenCode Go API key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tryreplicas.com/v1/opencode-go/credentials",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Set the organization OpenCode Go API key"
        },
        {
          "info": {
            "name": "Delete the organization OpenCode Go API key",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.tryreplicas.com/v1/opencode-go/credentials"
          },
          "docs": "Delete the organization OpenCode Go API key"
        },
        {
          "info": {
            "name": "Get personal OpenCode Go credential status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tryreplicas.com/v1/opencode-go/user/credentials"
          },
          "docs": "Get personal OpenCode Go credential status"
        },
        {
          "info": {
            "name": "Set the authenticated user's OpenCode Go API key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tryreplicas.com/v1/opencode-go/user/credentials",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Set the authenticated user's OpenCode Go API key"
        },
        {
          "info": {
            "name": "Delete the authenticated user's OpenCode Go API key",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.tryreplicas.com/v1/opencode-go/user/credentials"
          },
          "docs": "Delete the authenticated user's OpenCode Go API key"
        }
      ]
    }
  ],
  "bundled": true
}