  "item": [
    {
      "id": "c4002a83-f8c0-4eed-9164-581c0ce3b345",
      "name": "Analytics",
      "description": {
        "content": "Read aggregated activity and usage metrics for your organization: compute minutes, workspaces created by source, and pull request throughput over a time range.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "ebdc7eef-99a8-4d5e-a13a-1832eccbb1c1",
          "name": "Get Analytics Overview",
          "request": {
            "name": "Get Analytics Overview",
            "description": {
              "content": "Returns an aggregated overview of organization activity over a time range for organization admins: a per-bucket time series of workspaces created and pull requests opened, merged, and closed; compute-minute usage bucketed and broken down by workspace source; workspace counts grouped by source; and a summary total across the range.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "analytics",
                "overview"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "bucket",
                  "value": "day",
                  "description": "Time bucket granularity for the returned series. Defaults to `day`."
                },
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<dateTime>",
                  "description": "Inclusive start of the range as an ISO 8601 timestamp. Defaults to 30 days before `end`."
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<dateTime>",
                  "description": "Exclusive end of the range as an ISO 8601 timestamp. Defaults to the current time."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
